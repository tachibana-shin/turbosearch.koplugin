# Everything KOReader loads is generated: the Lua from tl/, the engine from cargo,
# and the per-platform release archives. There is no plugin/ in the repository —
# `make plugin` assembles it, and `make install` points the reader at it.
# The compile-time database sqlx verifies its checked macros against.
.sqlx-dev.db
.sqlx-dev.db-wal
.sqlx-dev.db-shm

build/

# Teal: the compiled Lua is a build artifact, the .tl source is not.
tl/*.lua

# Indexing scratch
*.idx
*.idx-wal
*.idx-shm

.env
target/
.indexer.log
