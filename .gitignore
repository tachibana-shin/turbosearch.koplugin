# Build artifacts: the engine library and the Lua compiled from Teal live in
# the plugin directory beside the source, and are produced by script/build-plugin.
plugin/turbosearch.koplugin/*.so
plugin/turbosearch.koplugin/**/*.so
plugin/turbosearch.koplugin/turbosearch.lua

# Teal: the compiled Lua is a build artifact, the .tl source is not.
tl/*.lua

# Indexing scratch
*.idx
*.idx-wal
*.idx-shm
