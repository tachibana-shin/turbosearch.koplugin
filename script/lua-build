#!/bin/bash
# Compiles the Teal sources into the Lua the plugin loads.
#
# `-c` fails the build on a type error rather than writing Lua that will not
# load, which is the difference between a mistake caught here and a plugin that
# opens and then does nothing. `-o` writes straight into the plugin directory,
# so no second copy has to be kept in step with it.
set -euo pipefail
cd "$(dirname "$0")/.."

BINDING="plugin/turbosearch.koplugin/turbosearch.lua"
SOURCES="tl/turbosearch.tl"

./script/tl gen -c --gen-target 5.1 --include-dir tl -o "$BINDING" $SOURCES

# Parse the result with LuaJIT, the interpreter that will actually run it. Teal
# targets 5.1 syntax, and this is the cheapest check that it is valid.
if command -v luajit >/dev/null 2>&1; then
    luajit -bl "$BINDING" /dev/null
fi
